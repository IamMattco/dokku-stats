#!/usr/bin/env bash
# Resource usage report consumed by Dokku UI (Dokku::StatsService).
# Output is pipe-separated, one record per line, first field is the record type:
#   host|<cpus>|<load1>|<mem_total>|<mem_used>|<disk_total>|<disk_used>
#   container|<id>|<name>|<image>|<state>|<status>|<size>|<app>|<process_type>
#   usage|<id>|<cpu%>|<mem_usage>|<mem%>|<net_io>|<block_io>|<pids>
#   disk|<app>|<repo_bytes>|<storage_bytes>
#
# stats:df       df|<type>|<total>|<active>|<size>|<reclaimable>   (docker system df)
# stats:services service|<plugin>|<name>|<container_id>|<data_bytes>
# stats:prune <build-cache|images>   removes docker build cache or dangling images
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x
source "$PLUGIN_CORE_AVAILABLE_PATH/common/functions"

DOCKER="${DOCKER_BIN:-docker}"
STORAGE_ROOT="${DOKKU_LIB_ROOT:-/var/lib/dokku}/data/storage"

stats_host() {
  local cpus load mem disk
  cpus="$(nproc 2>/dev/null || echo 0)"
  load="$(cut -d' ' -f1 /proc/loadavg 2>/dev/null || echo 0)"
  mem="$(free -b 2>/dev/null | awk '/^Mem:/ {print $2 "|" ($2 - $7)}')"
  disk="$(df -B1 --output=size,used /var/lib/docker 2>/dev/null | awk 'NR==2 {print $1 "|" $2}')"
  [[ -z "$disk" ]] && disk="$(df -B1 --output=size,used / 2>/dev/null | awk 'NR==2 {print $1 "|" $2}')"
  echo "host|$cpus|$load|${mem:-0|0}|${disk:-0|0}"
}

stats_containers() {
  # without an app, list every container so databases and other services show up too
  local filter=()
  [[ -n "$1" ]] && filter=(--filter "label=com.dokku.app-name=$1")

  "$DOCKER" ps -a -s "${filter[@]}" \
    --format 'container|{{.ID}}|{{.Names}}|{{.Image}}|{{.State}}|{{.Status}}|{{.Size}}|{{.Label "com.dokku.app-name"}}|{{.Label "com.dokku.process-type"}}'
}

stats_usage() {
  local ids
  if [[ -n "$1" ]]; then
    ids="$("$DOCKER" ps -q --filter "label=com.dokku.app-name=$1")"
    [[ -z "$ids" ]] && return 0
  fi

  # shellcheck disable=SC2086
  "$DOCKER" stats --no-stream $ids \
    --format 'usage|{{.ID}}|{{.CPUPerc}}|{{.MemUsage}}|{{.MemPerc}}|{{.NetIO}}|{{.BlockIO}}|{{.PIDs}}'
}

stats_disk() {
  local app="$1" repo storage cids
  repo="$(du -sb "$DOKKU_ROOT/$app" 2>/dev/null | cut -f1 || true)"

  storage=0
  cids="$("$DOCKER" ps -aq --filter "label=com.dokku.app-name=$app")"
  if [[ -n "$cids" ]]; then
    # only bind mounts under the dokku storage root, never arbitrary host paths
    # shellcheck disable=SC2086
    storage="$("$DOCKER" inspect --format '{{range .Mounts}}{{if eq .Type "bind"}}{{println .Source}}{{end}}{{end}}' $cids 2>/dev/null |
      grep "^$STORAGE_ROOT/" | sort -u |
      xargs -r du -sbc 2>/dev/null | awk '/\ttotal$/ {print $1}' || true)"
  fi

  echo "disk|$app|${repo:-0}|${storage:-0}"
}

cmd-stats-report() {
  declare desc="print resource usage of all containers, or of a single app"
  declare APP="$2"

  if [[ -n "$APP" ]]; then
    verify_app_name "$APP"
  fi

  stats_host
  stats_containers "$APP"
  stats_usage "$APP"

  if [[ -n "$APP" ]]; then
    stats_disk "$APP"
  else
    for app in $(dokku_apps 2>/dev/null || true); do
      stats_disk "$app"
    done
  fi
}

cmd-stats-df() {
  declare desc="print docker disk usage by type"
  "$DOCKER" system df --format 'df|{{.Type}}|{{.TotalCount}}|{{.Active}}|{{.Size}}|{{.Reclaimable}}'
}

cmd-stats-services() {
  declare desc="print data size of dokku service containers (postgres, mysql, redis...)"
  local container id name plugin service dest bytes

  "$DOCKER" ps --filter "name=^dokku\." --format '{{.ID}} {{.Names}}' | while read -r id name; do
    # container names look like dokku.<plugin>.<service>
    plugin="$(echo "$name" | cut -d. -f2)"
    service="$(echo "$name" | cut -d. -f3-)"
    [[ -z "$plugin" || -z "$service" ]] && continue

    bytes=0
    for dest in $("$DOCKER" inspect --format '{{range .Mounts}}{{println .Destination}}{{end}}' "$id" 2>/dev/null); do
      # measured inside the container: data dirs on the host are owned by the service user
      size="$("$DOCKER" exec "$id" du -sb "$dest" 2>/dev/null | cut -f1 || true)"
      bytes=$((bytes + ${size:-0}))
    done

    echo "service|$plugin|$service|$id|$bytes"
  done
}

cmd-stats-prune() {
  declare desc="remove docker build cache or dangling images"
  case "$2" in
    build-cache)
      "$DOCKER" builder prune -af
      ;;
    images)
      # dangling only: images of stopped apps must survive so ps:start keeps working
      "$DOCKER" image prune -f
      ;;
    *)
      dokku_log_fail "Usage: dokku stats:prune <build-cache|images>"
      ;;
  esac
}

case "$1" in
  stats:report)
    cmd-stats-report "$@"
    ;;

  stats:df)
    cmd-stats-df "$@"
    ;;

  stats:services)
    cmd-stats-services "$@"
    ;;

  stats:prune)
    cmd-stats-prune "$@"
    ;;

  help | stats:help)
    cat <<help_content
    stats:report [<app>], Print resource usage of all containers, or of a single app
    stats:df, Print docker disk usage by type
    stats:services, Print data size of service containers
    stats:prune <build-cache|images>, Remove docker build cache or dangling images
help_content
    ;;

  *)
    exit "$DOKKU_NOT_IMPLEMENTED_EXIT"
    ;;
esac
